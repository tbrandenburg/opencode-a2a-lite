{
  "$schema": "https://opencode.ai/config.json",
  "model": {
    "providerID": "openai",
    "model": "gpt-6-luna",
  },
  "default_agent": "repo",
  "agents": {
    "repo": {
      "mode": "primary",
      "description": "Read GitHub pull requests and CI evidence",
      "system": "{file:./repo.md}",
      "permissions": [
        {
          "action": "github_pull_request_read",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_list_pull_requests",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_search_pull_requests",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_actions_get",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_actions_list",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_get_job_logs",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_get_file_contents",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_list_commits",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "github_get_commit",
          "resource": "*",
          "effect": "allow",
        },
      ],
    },
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "github-mcp-server",
          "stdio",
          "--read-only",
          "--toolsets",
          "repos,pull_requests,actions",
        ],
        "codemode": false,
      },
    },
  },
  "snapshots": false,
  "warming": false,
}
