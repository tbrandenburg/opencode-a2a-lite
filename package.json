{
  "name": "opencode-a2a-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun dist/src/server.js",
    "build": "tsc --noEmit false --outDir dist --rootDir .",
    "fmt": "oxfmt",
    "fmt-check": "oxfmt --check",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@agentclientprotocol/sdk": "2.0.2",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.9"
}
